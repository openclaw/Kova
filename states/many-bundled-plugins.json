{
  "id": "many-bundled-plugins",
  "title": "Many Installed Plugins",
  "objective": "A pressure state for plugin and provider metadata paths on OpenClaw 2026.6.1 or newer. It installs synthetic local plugins through OpenClaw and verifies they are visible before startup and metadata measurements run.",
