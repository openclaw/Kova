  "bound": {
    "includes": [
      "sessions.companion.* and the Talk to Home dock: described in docs/concepts/main-session.md, this area's operation",
      "sessions.github.*: a session's changes, part of the session files and processes operation",
      "sessions.catalog.import and openclaw sessions import: importing a native transcript into a session is this area's operation",
      "openclaw sessions export-trajectory, /export and /export-session: this area's operation",
      "sessions.steer and chat.toolTitles: deprecated, listed as entry points and excluded with that reason",
      "channel routes (DM, group, thread), scheduled jobs and heartbeat, subagent and ACP calls, plugin hooks: entry points of kind from <area>; the area's operation they reach is listed, their own code is not",
      "src/agents/subagents/** and the spawn, yield and subagents tools: this area's operation (running background work with sub-agents); announce and auto-archive paths are entry points of kind from subagents"
    ],
    "excludes": [
      "sessions.move, sessions.dispatch, sessions.reclaim, worker placement, docs/gateway/cloud-workers/*, docs/gateway/cloud-sessions.md: owned by cloud workers",
      "sessions.catalog.list, read, continue, archive, host, startTerminal, docs/nodes/session-catalogs.md, docs/nodes/session-hosting.md: owned by session catalogs (nodes)",
      "sessions.usage, sessions.usage.logs, sessions.usage.timeseries, src/gateway/server-methods/usage.ts: owned by usage",
      "session.discussion.*, src/gateway/server-methods/session-discussion.ts: owned by the btw side-discussion tool",
      "src/agents/sessions/model-registry*.ts: owned by models",
      "docs/nodes/talk/*: owned by talk",
      "docs/tools/acp-agents/sessions.md: owned by ACP",
      "src/plugin-sdk/*session*.ts and docs/plugins/hooks/prompt-and-session.md: owned by the plugin SDK",
      "Windows-only path handling: owned by platform; a break that needs Windows is outside this template's reach",
      "docs/concepts/memory-provenance.md and openclaw memory forget: owned by memory; the --session form is listed as an entry point of kind from memory"
    ]
