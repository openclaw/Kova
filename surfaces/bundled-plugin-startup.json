{
  "id": "bundled-plugin-startup",
  "title": "Bundled Plugin Startup",
  "ownerArea": "plugins",
  "description": "Start OpenClaw with bundled plugins and prove plugin loading does not degrade the gateway.",
  "processRoles": [
    "gateway",
    "command-tree",
    "plugin-cli"
  ],
  "thresholds": {
    "gatewayReadyMs": 30000,
    "gatewayReadyHardTimeoutMs": 120000
  },
  "roleThresholds": {
    "gateway": {
      "peakRssMb": {
        "baselineByNodeMajor": { "22": 730, "24": 1085, "25": 1065 },
        "maxRegressionPercent": 10,
        "absoluteCeilingMb": 1200
      },
      "maxCpuPercent": 250
    },
    "plugin-cli": {
      "peakRssMb": 900,
      "maxCpuPercent": 250
    }
  },
  "diagnostics": {
    "timelineRequiredForSourceBuild": true,
    "expectedSpans": [
      "gateway.ready",
      "config.normalize",
      "plugins.metadata.scan",
      "plugins.load"
    ]
  },
  "purposes": [
    "performance",
    "plugin",
    "regression",
    "release"
  ],
  "requirements": [
    {
      "id": "baseline",
      "states": [
        "fresh",
        "many-bundled-plugins"
      ],
      "targetKinds": [
        "npm",
        "release",
        "runtime",
        "local-build"
      ],
      "metrics": [
        "gatewayReadyMs",
        "pluginLoadFailures",
        "missingDependencyErrors"
      ]
    }
  ]
}
