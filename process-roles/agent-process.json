{
  "id": "agent-process",
  "title": "Agent Process",
  "description": "Local agent execution processes, identified by their dedicated legacy title or generic OpenClaw title inside an owned local-agent invocation.",
  "commandPatterns": [],
  "processPatterns": [
    "(^|\\s|/)openclaw-agent(\\s|$)"
  ],
  "commandScopedProcessPatterns": [
    {
      "commandPatterns": [
        "^\\s*(?:(?:(?:[^\\s]*/)?node\\s+)?(?:[^\\s]*/)?openclaw(?:\\.m?js)?|(?:[^\\s]*/)?ocm\\s+@(?:'[^']*'|\"[^\"]*\"|[^\\s]+)\\s+--)\\s+agent\\s+--local(?:\\s|$)"
      ],
      "processPatterns": [
        "^openclaw$"
      ],
      "invocationPatterns": [
        "^\\s*(?:(?:(?:[^\\s]*/)?node\\s+)?(?:[^\\s]*/)?openclaw(?:\\.m?js)?|(?:[^\\s]*/)?ocm)\\s+\\S"
      ]
    }
  ]
}
